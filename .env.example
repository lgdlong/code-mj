# Supabase PostgreSQL (Transaction pooler for runtime + Direct for Prisma push/migrate)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Better Auth
BETTER_AUTH_SECRET="replace-with-32-char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated admin emails (promoted on first sign-up)
ADMIN_EMAIL=""

# Cloudflare R2 — video uploads only; images stay on Cloudinary
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="marjames-media"
# Public custom domain connected to the bucket. Must stay https and must not be r2.dev.
R2_PUBLIC_BASE_URL="https://assets.example.com"

# Cloudinary — legacy: only used to delete images uploaded before the R2 migration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
